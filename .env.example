# No credentials needed for labeled, local sample mode.
# For your own materials, set both OpenAI variables. Local-only AI is supported.
OPENAI_API_KEY=
OPENAI_MODEL=
# Set all four Supabase values for authenticated cloud persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_SECRET=
# Optional location for local development data; cloud mode uses Supabase.
STUDYFORGE_DATA_DIR=
